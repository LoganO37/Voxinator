{
  "manifest_version": 3,
  "name": "Voxinator",
  "version": "0.3.0",
  "description": "Pauses or ducks browser media when the native engine detects game/app dialog.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:* ws://localhost:*"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["page.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Voxinator",
    "default_popup": "options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "voxinator@local",
      "strict_min_version": "115.0"
    }
  }
}
